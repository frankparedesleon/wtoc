{
  "name": "@time-off-service/api",
  "version": "1.0.0",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest --testPathPattern=test/unit --passWithNoTests",
    "test:integration": "jest --testPathPattern=test/integration --passWithNoTests",
    "test:e2e": "jest --testPathPattern=test/e2e --passWithNoTests",
    "test:cov": "jest --coverage --passWithNoTests",
    "typeorm": "typeorm-ts-node-commonjs"
  },
  "dependencies": {
    "@mapbox/node-pre-gyp": "^2.0.3",
    "@nestjs/axios": "^3.1.3",
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/cqrs": "^10.2.8",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/schedule": "^4.1.2",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/typeorm": "^10.0.2",
    "@opentelemetry/api": "^1.8.0",
    "@opentelemetry/auto-instrumentations-node": "^0.46.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.52.0",
    "@opentelemetry/sdk-node": "^0.52.0",
    "axios": "^1.16.1",
    "better-sqlite3": "^11.10.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "luxon": "^3.7.2",
    "nest-winston": "^1.10.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sql.js": "^1.14.1",
    "typeorm": "^0.3.29",
    "uuid": "^9.0.1",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.4.22",
    "@types/better-sqlite3": "^7.6.12",
    "@types/jest": "^29.5.14",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20.19.41",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "src/**/*.(t|j)s"
    ],
    "coverageDirectory": "coverage",
    "testEnvironment": "node",
    "moduleDirectories": [
      "node_modules"
    ],
    "testTimeout": 30000,
    "modulePaths": [
      "../../node_modules"
    ],
    "coveragePathIgnorePatterns": [
      "node_modules",
      "dist",
      "test/",
      "src/main.ts",
      "src/app.module.ts",
      "src/modules/time-off/application/commands",
      "src/modules/time-off/application/queries",
      "src/modules/time-off/presentation",
      "src/modules/time-off/infrastructure/hcm-adapter",
      "src/modules/time-off/infrastructure/idempotency/idempotency.middleware.ts",
      "src/shared/filters",
      "src/shared/logging",
      "src/shared/tracing"
    ]
  }
}
