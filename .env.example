# App
PORT=3000
NODE_ENV=development

# Database
DB_PATH=data/time-off.db

# HCM Integration
HCM_BASE_URL=http://localhost:3001
HCM_TIMEOUT_MS=5000
HCM_RETRY_ATTEMPTS=3

# Circuit Breaker
CB_FAILURE_THRESHOLD=5
CB_HALF_OPEN_DELAY_MS=30000

# Balance
BALANCE_STALE_THRESHOLD_MINUTES=15

# Idempotency
IDEMPOTENCY_TTL_HOURS=24

# Batch Sync (cron expression)
BATCH_SYNC_CRON=0 */6 * * *

# Logging
LOG_DIR=logs

# Mock HCM (for tests only)
MOCK_HCM_PORT=3001
MOCK_HCM_URL=http://localhost:3001
